output "Acer Technologies KG251Q T8ZSJ00785C7" {
  mode "1920x1080@164.917"
  scale 1
  transform "normal"
  position x=0 y=0
  focus-at-startup
  // Enabled only while a window-rule with variable-refresh-rate is visible.
  variable-refresh-rate on-demand=true
}

output "PNP(ZSC) Display 000000001" {
  mode "1920x1080@60.000"
  scale 1
  transform "normal"
  position x=-1920 y=0
}

debug {
  // The iGPU is disabled in the BIOS. Keep niri off it anyway in case a BIOS
  // update or CMOS reset re-enables it: every amdgpu ring timeout/page fault
  // seen on this machine came from the iGPU, never from the RX 9060 XT.
  ignore-drm-device "/dev/dri/by-path/pci-0000:10:00.0-render"
}
