// Environment for spawned processes comes from the systemd user manager
// (niri runs as niri.service), so no `environment {}` block here.
// noctalia and easyeffects are systemd user services, not spawn-at-startup,
// so they get restarted if they crash.

animations {
    off
}

gestures {
  hot-corners {
    off
  }
}

cursor {
  xcursor-size 24
  hide-when-typing
  hide-after-inactive-ms 10000
}

hotkey-overlay {
  skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot-from-%Y-%m-%d-%H-%M-%S.png";

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}
